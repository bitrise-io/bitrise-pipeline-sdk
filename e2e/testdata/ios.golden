format_version: "26"
default_step_lib_source: https://github.com/bitrise-io/bitrise-steplib.git
project_type: ios
title: iOS CI/CD
trigger_map:
- type: push
  workflow: test
  push_branch: '*'
- type: tag
  workflow: archive
  tag: v*
workflows:
  archive:
    title: iOS Archive
    before_run:
    - test
    steps:
    - xcode-archive@6:
        inputs:
        - scheme: MyApp
        - project_path: MyApp.xcworkspace
        - distribution_method: app-store
        - automatic_code_signing: api-key
    - deploy-to-bitrise-io@2: {}
  test:
    title: iOS Tests
    steps:
    - activate-ssh-key@4: {}
    - git-clone@8: {}
    - xcode-test@6:
        inputs:
        - scheme: MyApp
        - project_path: MyApp.xcworkspace
        - destination: platform=iOS Simulator,name=iPhone 15,OS=latest
